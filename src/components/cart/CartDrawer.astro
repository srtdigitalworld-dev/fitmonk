---
import Icon from '../ui/Icon.astro';
---
<dialog class="cart-drawer" data-cart-drawer aria-labelledby="drawer-title"><div class="drawer-header"><div><p class="eyebrow">Your pantry picks</p><h2 id="drawer-title">Shopping bag <span data-cart-count>0</span></h2></div><button type="button" class="icon-button" data-close-cart aria-label="Close shopping bag"><Icon name="close" /></button></div><div class="drawer-body" data-cart-content="drawer"><p>Your bag is empty.</p></div></dialog>
