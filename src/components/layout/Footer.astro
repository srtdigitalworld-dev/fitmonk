---
import BrandLogo from '../ui/BrandLogo.astro';
import { categories } from '../../data/categories';
import { site } from '../../data/site';
---
<footer class="site-footer"><div class="page-container footer-grid"><div class="footer-brand"><BrandLogo footer /><p>A little variety for your everyday pantry.</p><a class="text-link" href={`https://wa.me/${site.whatsappOrderNumber}`} target="_blank" rel="noopener noreferrer">Let’s talk on WhatsApp ↗</a></div><div><h2>Explore the shop</h2><ul>{categories.filter(c=>!c.parent).map(c=><li><a href={`/shop/${c.slug}/`}>{c.name}</a></li>)}</ul></div><div><h2>Get to know us</h2><ul><li><a href="/about/">About Fit Monk</a></li><li><a href="/learn/">Learn &amp; food guides</a></li><li><a href="/contact/">Contact us</a></li><li><a href="/shop/">All products</a></li></ul></div><div><h2>Made personal</h2><p>Choose your packs online. Confirm availability, shipping and your order directly with the seller on WhatsApp.</p><a href="/cart/">Review your cart →</a></div></div><div class="page-container footer-bottom"><span>© {new Date().getFullYear()} {site.brandName}</span><span>Pick. Pack. Send on WhatsApp.</span><a href="#top">Back to top ↑</a></div></footer>
