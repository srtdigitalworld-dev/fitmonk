---
interface Props { eyebrow?: string; title: string; href?: string; linkText?: string }
const {eyebrow,title,href,linkText='Explore collection'}=Astro.props;
---
<div class="section-heading"><div>{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2>{title}</h2></div>{href && <a class="text-link" href={href}>{linkText} <span aria-hidden="true">↗</span></a>}</div>
