---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/dm-serif-display/latin-400-italic.css';
import { site } from '../data/site';
import Navigation from '../components/navigation/Navigation.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { absoluteUrl, organizationSchema } from '../lib/seo/schema';
import BrandLogo from '../components/ui/BrandLogo.astro';
import Footer from '../components/layout/Footer.astro';
import CartDrawer from '../components/cart/CartDrawer.astro';
import Commerce from '../components/cart/Commerce.astro';
interface Props { title?: string; description?: string; canonicalPath?: string; robots?: string; socialImage?: string | null; type?: 'website' | 'article'; bodyClass?: string }
const { title = site.defaultTitle, description = site.defaultDescription, canonicalPath = Astro.url.pathname, robots = site.indexable ? 'index,follow' : 'noindex,follow', socialImage = site.socialImage, type = 'website', bodyClass } = Astro.props;
const canonical = absoluteUrl(canonicalPath);
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="2QLNz8jTYP8QCD0pv4d_co64A85FPCHSZR-zoPmjl5U" />
    <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="robots" content={robots} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content={type} /><meta property="og:site_name" content={site.brandName} /><meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
    {socialImage && <><meta property="og:image" content={absoluteUrl(socialImage)} /><meta name="twitter:image" content={absoluteUrl(socialImage)} /></>}
    <JsonLd data={organizationSchema()} /><slot name="head" />
  </head>
  <body id="top" class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    {site.announcement && <div class="announcement"><div class="page-container"><span>{site.announcement}</span><a href="/contact/">Here to help <span aria-hidden="true">↗</span></a></div></div>}
    <header class="site-header"><div class="page-container header-inner"><BrandLogo /><Navigation /></div></header>
    <main id="main" class="page-container"><slot /></main>
    <Footer /><CartDrawer /><p class="sr-only" data-cart-announcement role="status" aria-live="polite"></p><Commerce />
  </body>
</html>
