---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/categories';
import { site } from '../../data/site';
import { getProducts } from '../../lib/catalog';
import ProductCard from '../../components/product/ProductCard.astro';
import Icon from '../../components/ui/Icon.astro';
const products = await getProducts();
---
<BaseLayout title={`Shop | ${site.brandName}`} description="Browse all 26 Fit Monk catalog products, compare packs and prepare a WhatsApp order."><div class="page-heading shop-heading"><p class="eyebrow">Shop all products</p><h1>The Fit Monk pantry.</h1><p>Browse 26 catalog products, compare packs and add your favourites to your bag.</p></div><nav class="category-chips" aria-label="Shop categories"><a href="/shop/" aria-current="page">All products</a>{categories.filter(c => !c.parent).map(c => <a href={`/shop/${c.slug}/`}>{c.name}</a>)}</nav><div class="shop-toolbar"><p data-results-count aria-live="polite">{products.length} products</p><label class="shop-search"><span class="sr-only">Search products</span><Icon name="search" size={18} /><input type="search" data-product-search placeholder="Find a pantry favourite" /></label></div><p data-search-empty class="notice" hidden>No products match that search. Try a different product name.</p><div class="product-grid">{products.map(p => <ProductCard product={p.data} />)}</div></BaseLayout>
