---
// Fit Monk Commerce Admin — Merchant Daily Business Control Center
// Protected Admin Portal for Catalog, Orders, Coupons, Shipping, WhatsApp & Settings
import '../../styles/admin.css';
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Fit Monk Merchant Control Center</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="admin-body h-full antialiased flex flex-col bg-slate-50 text-slate-800">

  <!-- ================= AUTH SCREEN (LOGIN) ================= -->
  <div id="auth-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 transition-opacity duration-300">
    <div class="w-full max-w-md bg-white border border-slate-200/90 rounded-2xl p-8 shadow-2xl relative overflow-hidden">
      <!-- Top Brand Accent Bar -->
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#D62828] via-[#F57C00] to-[#F4B400]"></div>

      <div class="flex items-center space-x-3.5 mb-6 pt-1">
        <div class="w-11 h-11 rounded-xl bg-[#D62828] flex items-center justify-center font-extrabold text-white text-xl shadow-md shadow-red-900/20">
          FM
        </div>
        <div>
          <h1 class="text-xl font-bold tracking-tight text-[#2E2E2E]">Fit Monk Store Admin</h1>
          <p class="text-xs text-slate-500 font-medium">Daily Merchant Business Control Center</p>
        </div>
      </div>

      <form id="login-form" class="space-y-4">
        <div id="login-error" class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium"></div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5" for="email">Admin Email</label>
          <input
            id="email"
            type="email"
            required
            value="admin@fitmonk.co.in"
            class="fm-input w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#D62828] transition-colors"
            placeholder="admin@fitmonk.co.in"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5" for="password">Password</label>
          <input
            id="password"
            type="password"
            required
            class="fm-input w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#D62828] transition-colors"
            placeholder="••••••••••••"
          />
        </div>

        <button
          type="submit"
          id="login-btn"
          class="w-full py-2.5 px-4 bg-[#D62828] hover:bg-[#b51e1e] active:bg-[#9c1818] font-bold text-white text-sm rounded-xl transition shadow-md shadow-red-900/20 flex items-center justify-center cursor-pointer"
        >
          <span>Sign In to Merchant Center</span>
        </button>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400 font-medium">
          <span>Fit Monk Commerce Engine</span>
          <span class="font-mono text-slate-500">100% Prepaid Policy</span>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= MAIN ADMIN APP CONTAINER ================= -->
  <div id="app-container" class="flex h-full w-full overflow-hidden">
    
    <!-- ================= 1. REDESIGNED ADMIN SIDEBAR ================= -->
    <aside class="w-64 bg-white border-r border-slate-200 flex flex-col flex-shrink-0 select-none shadow-sm z-20">
      <!-- Brand Header -->
      <div class="h-16 flex items-center justify-between px-5 border-b border-slate-200">
        <a href="/" target="_blank" class="flex items-center space-x-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-[#D62828] flex items-center justify-center font-extrabold text-white text-base shadow-sm">
            FM
          </div>
          <div>
            <div class="text-sm font-extrabold text-[#2E2E2E] tracking-tight flex items-center gap-1.5">
              FIT MONK
              <span class="text-[9px] uppercase font-mono px-1.5 py-0.5 rounded bg-amber-50 text-[#F57C00] font-bold border border-amber-200">Prepaid</span>
            </div>
            <div class="text-[11px] text-slate-500 group-hover:text-[#D62828] transition-colors flex items-center gap-1">
              Storefront <span class="text-[10px]">&nearr;</span>
            </div>
          </div>
        </a>
      </div>

      <!-- Merchant Navigation Links -->
      <nav class="flex-1 overflow-y-auto p-3 space-y-1 admin-scrollbar text-xs font-medium">
        
        <!-- GROUP: HOME -->
        <div class="px-2 pt-2 pb-1 text-[10px] uppercase tracking-wider text-slate-400 font-extrabold">Home</div>
        <button data-tab="dashboard" class="nav-item admin-nav-btn active-nav w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-[#D62828]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </button>

        <!-- GROUP: SALES -->
        <div class="px-2 pt-3 pb-1 text-[10px] uppercase tracking-wider text-slate-400 font-extrabold">Sales</div>
        <button data-tab="orders" class="nav-item admin-nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
            <span>Orders</span>
          </div>
          <span id="nav-orders-badge" class="hidden px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">0</span>
        </button>
        <button data-tab="customers" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          Customers
        </button>

        <!-- GROUP: CATALOG -->
        <div class="px-2 pt-3 pb-1 text-[10px] uppercase tracking-wider text-slate-400 font-extrabold">Catalog</div>
        <button data-tab="products" class="nav-item admin-nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-[#F57C00]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
            <span>Products</span>
          </div>
          <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700">26</span>
        </button>
        <button data-tab="categories" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-[#8B4513]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
          Categories (8)
        </button>
        <button data-tab="inventory" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
          Inventory
        </button>
        <button data-tab="media" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          Media Library
        </button>

        <!-- GROUP: MARKETING -->
        <div class="px-2 pt-3 pb-1 text-[10px] uppercase tracking-wider text-slate-400 font-extrabold">Marketing</div>
        <button data-tab="coupons" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-[#D62828]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
          Coupons & Discounts
        </button>

        <!-- GROUP: FULFILLMENT -->
        <div class="px-2 pt-3 pb-1 text-[10px] uppercase tracking-wider text-slate-400 font-extrabold">Fulfillment</div>
        <button data-tab="shipping" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
          Shipping (RapidShyp)
        </button>
        <button data-tab="delivery" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" /></svg>
          Delivery Rates
        </button>

        <!-- GROUP: ANALYTICS -->
        <div class="px-2 pt-3 pb-1 text-[10px] uppercase tracking-wider text-slate-400 font-extrabold">Analytics</div>
        <button data-tab="reports" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          Reports & Insights
        </button>

        <!-- GROUP: SETTINGS -->
        <div class="px-2 pt-3 pb-1 text-[10px] uppercase tracking-wider text-slate-400 font-extrabold">Settings</div>
        <button data-tab="payments" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
          Payments (Prepaid UPI)
        </button>
        <button data-tab="settings" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Store Settings
        </button>
        <button data-tab="notifications" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-[#F4B400]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
          Notifications
        </button>
        <button data-tab="whatsapp" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
          WhatsApp Channel
        </button>
        <button data-tab="admins" class="nav-item admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
          <svg class="w-4 h-4 text-[#D62828]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          Admins & Audit
        </button>
      </nav>

      <!-- User footer -->
      <div class="p-3 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded-full bg-[#D62828]/10 flex items-center justify-center text-xs font-bold text-[#D62828] border border-red-200">
            A
          </div>
          <div>
            <div id="admin-name" class="text-xs font-bold text-slate-800">Admin User</div>
            <div class="text-[10px] text-slate-500 font-medium">Store Operator</div>
          </div>
        </div>
        <button id="logout-btn" title="Logout" class="p-1.5 text-slate-400 hover:text-[#D62828] hover:bg-red-50 rounded-lg transition cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
        </button>
      </div>
    </aside>

    <!-- ================= CONTENT AREA ================= -->
    <main class="flex-1 flex flex-col min-w-0 bg-[#F8FAFC] overflow-hidden">
      
      <!-- Top Operational Bar -->
      <header class="h-16 border-b border-slate-200 px-6 flex items-center justify-between bg-white flex-shrink-0 shadow-xs z-10">
        <div>
          <div class="flex items-center gap-2">
            <h2 id="merchant-greeting" class="text-base font-extrabold text-[#2E2E2E] tracking-tight">Good morning, Store Admin</h2>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Live Store
            </span>
          </div>
          <p id="merchant-date" class="text-xs text-slate-500 font-medium mt-0.5">Saturday, 3 October 2026</p>
        </div>

        <div class="flex items-center space-x-2.5">
          <a href="/shop/" target="_blank" class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 rounded-lg border border-slate-300 transition shadow-2xs flex items-center gap-1.5">
            <span>Storefront</span>
            <span class="text-slate-400">&nearr;</span>
          </a>
          <button id="header-add-product-btn" class="px-3.5 py-1.5 text-xs font-bold bg-[#D62828] hover:bg-[#b51e1e] text-white rounded-lg transition shadow-xs flex items-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span>+ Add Product</span>
          </button>
          <button onclick="window.refreshMerchantData()" title="Sync live orders and catalog" class="p-1.5 text-slate-500 hover:text-slate-800 bg-white hover:bg-slate-50 rounded-lg border border-slate-300 transition shadow-2xs cursor-pointer">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
          </button>
        </div>
      </header>

      <!-- Scrollable Tab Container -->
      <div class="flex-1 overflow-y-auto p-6 admin-scrollbar space-y-6">
        
        <!-- ================= 1. REDESIGNED MERCHANT DASHBOARD ================= -->
        <div id="tab-dashboard" class="tab-content active space-y-6">

          <!-- 1A. PRIMARY KPI CARDS -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Today's Sales -->
            <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs hover:border-slate-300 transition relative overflow-hidden">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Today's Sales</span>
                <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xs">₹</span>
              </div>
              <div id="kpi-today-sales" class="text-3xl font-extrabold text-[#2E2E2E] mt-2 font-mono">₹0.00</div>
              <div class="text-[11px] text-slate-500 font-medium mt-2 flex items-center gap-1.5">
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Prepaid orders received today</span>
              </div>
            </div>

            <!-- Orders Today -->
            <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs hover:border-slate-300 transition relative overflow-hidden">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Orders Today</span>
                <span class="w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xs">#</span>
