---
// Fit Monk Commerce Admin CMS
// Protected Admin Portal for Catalog, Orders, Coupons, Shipping, WhatsApp & Settings
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900 text-slate-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Fit Monk Admin — Commerce Management System</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    code, pre {
      font-family: 'JetBrains Mono', monospace;
    }
    .scrollbar-thin::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 3px;
    }
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }
  </style>
</head>
<body class="h-full antialiased overflow-hidden flex flex-col">

  <!-- ================= AUTH CONTAINER (LOGIN) ================= -->
  <div id="auth-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950 p-4 transition-opacity duration-300">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl relative overflow-hidden">
      <!-- Glow Accent -->
      <div class="absolute -top-24 -left-24 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex items-center space-x-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center font-bold text-white text-xl shadow-lg shadow-emerald-900/30">
          FM
        </div>
        <div>
          <h1 class="text-xl font-bold tracking-tight text-white">Fit Monk Admin</h1>
          <p class="text-xs text-slate-400">Store Management & Commerce Engine</p>
        </div>
      </div>

      <form id="login-form" class="space-y-4">
        <div id="login-error" class="hidden p-3 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs"></div>

        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1.5" for="email">Admin Email</label>
          <input
            id="email"
            type="email"
            required
            value="admin@fitmonk.co.in"
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"
            placeholder="admin@fitmonk.co.in"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1.5" for="password">Password</label>
          <input
            id="password"
            type="password"
            required
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"
            placeholder="••••••••••••"
          />
        </div>

        <button
          type="submit"
          id="login-btn"
          class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 font-semibold text-white text-sm rounded-xl transition shadow-lg shadow-emerald-900/20 flex items-center justify-center"
        >
          <span>Sign In to Dashboard</span>
        </button>

        <p class="text-[11px] text-center text-slate-500 pt-2">
          Protected Edge Authentication &bull; WebCrypto PBKDF2
        </p>
      </form>
    </div>
  </div>

  <!-- ================= MAIN ADMIN APP ================= -->
  <div id="app-container" class="flex h-full w-full overflow-hidden">
    
    <!-- SIDEBAR -->
    <aside class="w-64 bg-slate-950 border-r border-slate-800 flex flex-col flex-shrink-0 select-none">
      <!-- Brand Header -->
      <div class="h-16 flex items-center justify-between px-5 border-b border-slate-800/80">
        <a href="/" target="_blank" class="flex items-center space-x-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center font-extrabold text-slate-950 text-base shadow-sm">
            FM
          </div>
          <div>
            <div class="text-sm font-bold text-white tracking-wide flex items-center gap-1.5">
              FIT MONK
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-semibold">CMS</span>
            </div>
            <div class="text-[10px] text-slate-400">View Public Store &nearr;</div>
          </div>
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="flex-1 overflow-y-auto p-3 space-y-1 scrollbar-thin text-xs font-medium">
        <div class="px-2 pt-2 pb-1 text-[10px] uppercase tracking-wider text-slate-500 font-bold">Commerce Core</div>
        
        <button data-tab="dashboard" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition active-nav">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
          Dashboard
        </button>

        <button data-tab="products" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
          Products (26)
        </button>

        <button data-tab="categories" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
          Categories (5)
        </button>

        <button data-tab="media" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          Media Library (R2)
        </button>

        <button data-tab="coupons" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
          Coupons & Discounts
          <span class="ml-auto bg-rose-500/20 text-rose-300 text-[10px] px-1.5 py-0.5 rounded font-bold">Engine</span>
        </button>

        <div class="px-2 pt-4 pb-1 text-[10px] uppercase tracking-wider text-slate-500 font-bold">Sales & Fulfillment</div>

        <button data-tab="orders" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
          Orders
        </button>

        <button data-tab="customers" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          Customers
        </button>

        <button data-tab="payments" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
          Payments (UPI / COD)
        </button>

        <button data-tab="delivery" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" /></svg>
          Delivery Methods
        </button>

        <button data-tab="shipping" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
          Shipping (RapidShyp)
        </button>

        <div class="px-2 pt-4 pb-1 text-[10px] uppercase tracking-wider text-slate-500 font-bold">Channels & System</div>

        <button data-tab="whatsapp" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
          WhatsApp Channel
        </button>

        <button data-tab="notifications" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
          Templates
        </button>

        <button data-tab="settings" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Store Settings
        </button>

        <button data-tab="admins" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800/80 hover:text-white transition">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          Admins & Audit
        </button>
      </nav>

      <!-- User footer -->
      <div class="p-3 border-t border-slate-800/80 flex items-center justify-between">
        <div class="flex items-center space-x-2.5">
          <div class="w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center text-xs font-semibold text-emerald-400 border border-slate-700">
            A
          </div>
          <div>
            <div id="admin-name" class="text-xs font-semibold text-slate-200">Admin User</div>
            <div class="text-[10px] text-slate-400">Super Administrator</div>
          </div>
        </div>
        <button id="logout-btn" title="Logout" class="p-1.5 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-lg transition">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
        </button>
      </div>
    </aside>

    <!-- CONTENT AREA -->
    <main class="flex-1 flex flex-col min-w-0 bg-slate-900 overflow-hidden">
      <!-- Top Bar -->
      <header class="h-16 border-b border-slate-800 px-6 flex items-center justify-between bg-slate-900/60 backdrop-blur-md flex-shrink-0">
        <div>
          <h2 id="view-title" class="text-lg font-bold text-white tracking-tight">Overview Dashboard</h2>
          <p id="view-subtitle" class="text-xs text-slate-400">Real-time health, catalog statistics, and activity</p>
        </div>
        <div class="flex items-center space-x-3">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Cloudflare D1 Active
          </span>
          <button onclick="window.location.reload()" class="px-3 py-1.5 text-xs font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 rounded-lg border border-slate-700 transition">
            Refresh
          </button>
        </div>
      </header>

      <!-- Scrollable Tab Container -->
      <div class="flex-1 overflow-y-auto p-6 scrollbar-thin">
        
        <!-- ================= 1. DASHBOARD ================= -->
        <div id="tab-dashboard" class="tab-content active space-y-6">
          <!-- Metric Cards -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-5 shadow-sm">
              <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Products</div>
              <div class="text-2xl font-bold text-white mt-1">26</div>
              <div class="text-xs text-emerald-400 mt-2 flex items-center gap-1">
                <span>&bull;</span> 26 Active in Catalog
              </div>
            </div>

            <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-5 shadow-sm">
              <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Active Coupons</div>
              <div class="text-2xl font-bold text-white mt-1">3</div>
              <div class="text-xs text-rose-400 mt-2 flex items-center gap-1">
                <span>&bull;</span> WELCOME10, FITMONK50
              </div>
            </div>

            <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-5 shadow-sm">
              <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Shipping Engine</div>
              <div class="text-2xl font-bold text-white mt-1">RapidShyp</div>
              <div class="text-xs text-purple-400 mt-2 flex items-center gap-1">
                <span>&bull;</span> Modular B2C Ready
              </div>
            </div>

            <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-5 shadow-sm">
              <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Primary Channel</div>
              <div class="text-2xl font-bold text-white mt-1">WhatsApp</div>
              <div class="text-xs text-emerald-400 mt-2 flex items-center gap-1">
                <span>&bull;</span> wa.me + Cloud API Ready
              </div>
            </div>
          </div>

          <!-- Architecture Status Panel -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-6">
            <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Fit Monk Commerce Architecture Foundation
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
              <div class="p-4 rounded-lg bg-slate-900 border border-slate-800">
                <div class="font-bold text-slate-200">Catalog & Media</div>
                <p class="text-slate-400 mt-1 leading-relaxed">26 Products preserved from static collection into relational D1 schema. Media ready for Cloudflare R2 bucket.</p>
              </div>
              <div class="p-4 rounded-lg bg-slate-900 border border-slate-800">
                <div class="font-bold text-slate-200">Discounts & Pricing Engine</div>
                <p class="text-slate-400 mt-1 leading-relaxed">Authoritative server-side paise calculations for subtotal, discount, shipping, tax, and grand totals.</p>
              </div>
              <div class="p-4 rounded-lg bg-slate-900 border border-slate-800">
                <div class="font-bold text-slate-200">Provider Abstraction</div>
                <p class="text-slate-400 mt-1 leading-relaxed">Pluggable interfaces for Payment, Shipping (RapidShyp), and Notifications (WhatsApp Cloud).</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= 2. PRODUCTS ================= -->
        <div id="tab-products" class="tab-content space-y-4">
          <div class="flex items-center justify-between">
            <div class="text-sm text-slate-400">All 26 Fit Monk products loaded with variants and pricing</div>
            <button class="px-3 py-1.5 text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition">
              + New Product
            </button>
          </div>
          <div class="bg-slate-950 border border-slate-800 rounded-xl overflow-hidden shadow-sm">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-900/80 text-slate-400 uppercase tracking-wider font-semibold border-b border-slate-800">
                <tr>
                  <th class="p-3.5">Product</th>
                  <th class="p-3.5">Category</th>
                  <th class="p-3.5">Base Price</th>
                  <th class="p-3.5">Status</th>
                  <th class="p-3.5">Actions</th>
                </tr>
              </thead>
              <tbody id="products-table-body" class="divide-y divide-slate-800/80 text-slate-300">
                <tr>
                  <td class="p-3.5 font-medium text-white">Dates Dry Fruits Punch</td>
                  <td class="p-3.5">Healthy Bites & Laddus</td>
                  <td class="p-3.5 font-mono">₹299.00</td>
                  <td class="p-3.5"><span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/20 text-emerald-400">Active</span></td>
                  <td class="p-3.5"><button class="text-emerald-400 hover:underline">Edit</button></td>
                </tr>
