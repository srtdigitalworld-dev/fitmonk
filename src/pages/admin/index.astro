                <div class="grid grid-cols-2 gap-2">
                  <button onclick="window.copyCustomerPhone()" class="py-1.5 px-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] rounded-lg transition flex items-center justify-center gap-1 cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                    <span>Copy Phone</span>
                  </button>
                  <button onclick="window.copyCustomerAddress()" class="py-1.5 px-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] rounded-lg transition flex items-center justify-center gap-1 cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                    <span>Copy Address</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- 4. PAYMENT CARD (100% PREPAID ONLY) -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs space-y-3">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span>Prepaid Payment</span>
                </h4>
                <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">Strictly Prepaid</span>
              </div>

              <div class="space-y-2 text-xs">
                <div class="flex justify-between">
                  <span class="text-slate-400 font-semibold">Method:</span>
                  <span id="od-payment-method" class="font-bold text-slate-800">Direct UPI / QR</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-400 font-semibold">Transaction Ref / UTR:</span>
                  <span id="od-payment-ref" class="font-mono text-slate-800 font-semibold">—</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-400 font-semibold">Payment Date:</span>
                  <span id="od-payment-date" class="font-mono text-slate-600">—</span>
                </div>
                <div class="pt-2 border-t border-slate-100 text-[11px] text-slate-500 font-medium">
                  Zero COD Policy: Dispatch allowed only after payment status is Paid.
                </div>
              </div>
            </div>

            <!-- 8. ORDER OPERATIONAL STATE ACTIONS -->
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs space-y-3">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-[#D62828]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
                  <span>Order Operations</span>
                </h4>
                <span class="text-[11px] text-slate-400">Lifecycle</span>
              </div>

              <!-- State Action Buttons Container -->
              <div id="od-state-actions" class="space-y-2">
                <!-- Dynamically rendered based on current order state -->
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- MODAL FOOTER -->
      <div class="px-6 py-3.5 border-t border-slate-200 bg-white flex items-center justify-between flex-shrink-0">
        <div class="text-[11px] text-slate-400 font-medium">
          Fit Monk Merchant Operations &bull; Prepaid Fulfillment Engine
        </div>
        <button onclick="window.closeOrderDetailModal()" class="px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 rounded-lg transition border border-slate-300 cursor-pointer">
          Close Window
        </button>
      </div>

    </div>
  </div>

  <!-- ================= SHIPMENT TRACKING MODAL ================= -->
  <div id="order-tracking-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 hidden">
    <div class="w-full max-w-lg bg-white border border-slate-200 rounded-2xl p-6 shadow-2xl relative max-h-[85vh] flex flex-col overflow-hidden">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h3 class="text-base font-bold text-[#2E2E2E]">Courier Tracking Live</h3>
          <p id="tracking-modal-awb" class="text-xs font-mono text-purple-700 mt-0.5">AWB: —</p>
        </div>
        <button onclick="document.getElementById('order-tracking-modal').classList.add('hidden')" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100 transition cursor-pointer">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <div id="tracking-events-container" class="flex-1 overflow-y-auto py-4 space-y-3 admin-scrollbar text-xs">
        <div class="text-slate-400 text-center py-6">Fetching tracking status from RapidShyp...</div>
      </div>
    </div>
  </div>

  <!-- ================= FLOATING TOAST FEEDBACK ================= -->
  <div id="admin-toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <div class="px-4 py-2.5 bg-slate-900 text-white rounded-xl shadow-xl text-xs font-semibold flex items-center gap-2 border border-slate-700">
      <span id="admin-toast-icon" class="text-emerald-400">✓</span>
      <span id="admin-toast-text">Action completed successfully</span>
    </div>
  </div>

  <!-- ================= CLIENT JAVASCRIPT ================= -->
  <script is:inline>
    // State Store
    let adminProducts = [];
    let adminOrders = [];
    let activeSalesRange = 'today';

    // Elements
    const navItems = document.querySelectorAll('.nav-item');
    const tabContents = document.querySelectorAll('.tab-content');
    const merchantGreeting = document.getElementById('merchant-greeting');
    const merchantDate = document.getElementById('merchant-date');

    // Dynamic greeting & date
    function updateGreetingAndDate(adminName) {
      const now = new Date();
      const hour = now.getHours();
      let greeting = 'Good morning';
      if (hour >= 12 && hour < 17) greeting = 'Good afternoon';
      else if (hour >= 17) greeting = 'Good evening';

      const name = adminName || 'Store Admin';
      if (merchantGreeting) {
        merchantGreeting.textContent = `${greeting}, ${name}`;
      }

      if (merchantDate) {
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        merchantDate.textContent = now.toLocaleDateString('en-IN', options);
      }
    }

    // Tab Switching
    window.switchTab = function(tab) {
      if (!tab) return;
      navItems.forEach(b => {
        if (b.getAttribute('data-tab') === tab) {
          b.classList.add('active-nav');
        } else {
          b.classList.remove('active-nav');
        }
      });

      tabContents.forEach(tc => tc.classList.remove('active'));
      const target = document.getElementById('tab-' + tab);
      if (target) target.classList.add('active');

      if (tab === 'products') loadAdminProducts();
      if (tab === 'orders') loadAdminOrders();
      if (tab === 'inventory') renderInventoryTable(adminProducts);
    };

    navItems.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        window.switchTab(tab);
      });
    });

    // Check Auth on load
    const authScreen = document.getElementById('auth-screen');
    const loginForm = document.getElementById('login-form');
    const loginError = document.getElementById('login-error');
    const logoutBtn = document.getElementById('logout-btn');

    async function checkAuth() {
      try {
        const res = await fetch('/api/auth/me');
        if (res.ok) {
          const data = await res.json();
          if (data.authenticated) {
            authScreen.classList.add('hidden');
            const adminName = data.admin?.name || 'Store Admin';
            const el = document.getElementById('admin-name');
            if (el) el.textContent = adminName;
            updateGreetingAndDate(adminName);

            // Fetch live operational data
            await Promise.all([loadAdminProducts(), loadAdminOrders()]);
            return;
          }
        }
      } catch (e) {
        // Fallback
      }
      authScreen.classList.remove('hidden');
      updateGreetingAndDate('Store Admin');
    }

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginError.classList.add('hidden');
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          authScreen.classList.add('hidden');
          const adminName = data.admin?.name || 'Store Admin';
          const el = document.getElementById('admin-name');
          if (el) el.textContent = adminName;
          updateGreetingAndDate(adminName);
          await Promise.all([loadAdminProducts(), loadAdminOrders()]);
        } else {
          loginError.textContent = data.message || 'Login failed.';
          loginError.classList.remove('hidden');
        }
      } catch (err) {
        loginError.textContent = 'Server error during authentication.';
        loginError.classList.remove('hidden');
      }
    });

    logoutBtn.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.reload();
    });

    // Load Products
    async function loadAdminProducts() {
      try {
        const res = await fetch('/api/products?limit=100');
        if (!res.ok) throw new Error('Failed to load products');
        const data = await res.json();
        adminProducts = data.products || [];
        renderProductsTable(adminProducts);
        renderInventoryTable(adminProducts);
        renderDashboardTopProducts(adminProducts);
        updateCatalogBadge(adminProducts);
      } catch (err) {
        console.warn('Error loading products from D1:', err);
      }
    }

    // Load Orders
    async function loadAdminOrders() {
      try {
        const res = await fetch('/api/orders');
        if (res.ok) {
          const data = await res.json();
          adminOrders = data.orders || [];
        } else {
          adminOrders = [];
        }
      } catch (e) {
        adminOrders = [];
      }
      renderDashboardOrders(adminOrders);
      renderOrdersTable(adminOrders);
      calculateKPIs(adminOrders);
    }

    // Refresh All Data
    window.refreshMerchantData = async function() {
      await Promise.all([loadAdminProducts(), loadAdminOrders()]);
    };

    // Calculate Dashboard KPIs & Pipeline
    function calculateKPIs(orders) {
      const now = new Date();
      const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime() / 1000;

      const todayOrders = orders.filter(o => o.created_at >= startOfToday);
      const paidOrders = orders.filter(o => o.payment_status === 'paid');
      const todayPaidOrders = todayOrders.filter(o => o.payment_status === 'paid');

      // 1. Sales Today
      const todaySalesPaise = todayPaidOrders.reduce((sum, o) => sum + (o.grand_total_paise || 0), 0);
      const todaySalesFmt = `₹${(todaySalesPaise / 100).toFixed(2)}`;
      const todaySalesEl = document.getElementById('kpi-today-sales');
      if (todaySalesEl) todaySalesEl.textContent = todaySalesFmt;

      // 2. Orders Today
      const todayOrdersEl = document.getElementById('kpi-today-orders');
      if (todayOrdersEl) todayOrdersEl.textContent = todayOrders.length;

      // 3. Needs Action
      const needsActionOrders = orders.filter(o => 
        o.payment_status === 'pending' || 
        o.fulfillment_status === 'unfulfilled' || 
        o.order_status === 'pending'
      );
      const actionEl = document.getElementById('kpi-orders-action');
      const actionDescEl = document.getElementById('kpi-action-desc');
      const actionDotEl = document.getElementById('kpi-action-dot');
      const navBadge = document.getElementById('nav-orders-badge');

      if (actionEl) actionEl.textContent = needsActionOrders.length;
      if (needsActionOrders.length > 0) {
        if (actionDescEl) actionDescEl.textContent = `${needsActionOrders.length} order(s) require fulfillment or review`;
        if (actionDotEl) {
          actionDotEl.classList.remove('bg-emerald-500');
          actionDotEl.classList.add('bg-[#D62828]');
        }
        if (navBadge) {
          navBadge.textContent = needsActionOrders.length;
          navBadge.classList.remove('hidden');
        }
      } else {
        if (actionDescEl) actionDescEl.textContent = 'All caught up & ready';
        if (actionDotEl) {
          actionDotEl.classList.remove('bg-[#D62828]');
          actionDotEl.classList.add('bg-emerald-500');
        }
        if (navBadge) navBadge.classList.add('hidden');
      }

      // 4. AOV
      const aovEl = document.getElementById('kpi-aov');
      if (aovEl) {
        if (todayPaidOrders.length > 0) {
          const aov = todaySalesPaise / todayPaidOrders.length / 100;
          aovEl.textContent = `₹${aov.toFixed(2)}`;
        } else if (paidOrders.length > 0) {
          const allPaidTotal = paidOrders.reduce((sum, o) => sum + (o.grand_total_paise || 0), 0);
          const aov = allPaidTotal / paidOrders.length / 100;
          aovEl.textContent = `₹${aov.toFixed(2)}`;
        } else {
          aovEl.textContent = '₹0.00';
        }
      }

      // 5. Needs Attention Operational Bar
      const unconfirmed = orders.filter(o => o.order_status === 'pending').length;
      const paymentPending = orders.filter(o => o.payment_status === 'pending').length;
      const readyShip = orders.filter(o => o.fulfillment_status === 'packed' || (o.payment_status === 'paid' && o.fulfillment_status === 'unfulfilled')).length;
      const rto = orders.filter(o => o.fulfillment_status === 'rto' || o.fulfillment_status === 'returned').length;

      const unconfirmedEl = document.getElementById('attn-unconfirmed-count');
      const payPendingEl = document.getElementById('attn-payment-pending-count');
      const readyShipEl = document.getElementById('attn-ready-ship-count');
      const rtoEl = document.getElementById('attn-rto-count');

      if (unconfirmedEl) unconfirmedEl.textContent = unconfirmed;
      if (payPendingEl) payPendingEl.textContent = paymentPending;
      if (readyShipEl) readyShipEl.textContent = readyShip;
      if (rtoEl) rtoEl.textContent = rto;

      // 6. Pipeline Counts
      const pNew = orders.filter(o => o.order_status === 'pending').length;
      const pPaid = orders.filter(o => o.payment_status === 'paid').length;
      const pConfirmed = orders.filter(o => o.order_status === 'confirmed').length;
      const pProcessing = orders.filter(o => o.order_status === 'processing').length;
      const pPacked = orders.filter(o => o.fulfillment_status === 'packed').length;
      const pShipped = orders.filter(o => o.fulfillment_status === 'shipped').length;
      const pDelivered = orders.filter(o => o.fulfillment_status === 'delivered').length;

      const elPNew = document.getElementById('pipeline-new');
      const elPPaid = document.getElementById('pipeline-paid');
      const elPConf = document.getElementById('pipeline-confirmed');
      const elPProc = document.getElementById('pipeline-processing');
      const elPPack = document.getElementById('pipeline-packed');
      const elPShip = document.getElementById('pipeline-shipped');
      const elPDel = document.getElementById('pipeline-delivered');

      if (elPNew) elPNew.textContent = pNew;
      if (elPPaid) elPPaid.textContent = pPaid;
      if (elPConf) elPConf.textContent = pConfirmed;
      if (elPProc) elPProc.textContent = pProcessing;
      if (elPPack) elPPack.textContent = pPacked;
      if (elPShip) elPShip.textContent = pShipped;
      if (elPDel) elPDel.textContent = pDelivered;

      // 7. Sales Overview Range Calculation
      updateSalesOverview(orders, activeSalesRange);
    }

    function updateCatalogBadge(products) {
      const activeCount = products.filter(p => Boolean(p.is_available)).length;
      const disabledCount = products.length - activeCount;
      const catalogEl = document.getElementById('attn-catalog-count');
      if (catalogEl) {
        catalogEl.textContent = `${activeCount} Active`;
        catalogEl.nextElementSibling.textContent = `${disabledCount} disabled in D1`;
      }
    }

    // Sales Overview Range Filter
    function updateSalesOverview(orders, range) {
      const now = new Date();
      let startTimestamp = 0;

      if (range === 'today') {
        startTimestamp = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime() / 1000;
      } else if (range === '7days') {
        startTimestamp = (now.getTime() - 7 * 24 * 3600 * 1000) / 1000;
      } else if (range === '30days') {
        startTimestamp = (now.getTime() - 30 * 24 * 3600 * 1000) / 1000;
      } else if (range === 'month') {
        startTimestamp = new Date(now.getFullYear(), now.getMonth(), 1).getTime() / 1000;
      }

      const filteredOrders = orders.filter(o => o.created_at >= startTimestamp);
      const paidOrders = filteredOrders.filter(o => o.payment_status === 'paid');
      const totalSalesPaise = paidOrders.reduce((sum, o) => sum + (o.grand_total_paise || 0), 0);

      const grossEl = document.getElementById('overview-gross-sales');
      const countEl = document.getElementById('overview-total-orders');
      const aovEl = document.getElementById('overview-aov');

      if (grossEl) grossEl.textContent = `₹${(totalSalesPaise / 100).toFixed(2)}`;
      if (countEl) countEl.textContent = filteredOrders.length;
      if (aovEl) {
        if (paidOrders.length > 0) {
          aovEl.textContent = `₹${(totalSalesPaise / paidOrders.length / 100).toFixed(2)}`;
        } else {
          aovEl.textContent = '₹0.00';
        }
      }
    }

    document.querySelectorAll('.sales-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.sales-filter-btn').forEach(b => {
          b.classList.remove('bg-white', 'text-[#D62828]', 'font-bold', 'shadow-2xs');
          b.classList.add('hover:text-slate-900');
        });
        btn.classList.add('bg-white', 'text-[#D62828]', 'font-bold', 'shadow-2xs');
        btn.classList.remove('hover:text-slate-900');
        activeSalesRange = btn.getAttribute('data-range') || 'today';
        updateSalesOverview(adminOrders, activeSalesRange);
      });
    });

    // Toast notification helper
    function showToast(msg, icon = '✓') {
      const toast = document.getElementById('admin-toast');
      const toastText = document.getElementById('admin-toast-text');
      const toastIcon = document.getElementById('admin-toast-icon');
      if (!toast) return;
      if (toastText) toastText.textContent = msg;
      if (toastIcon) toastIcon.textContent = icon;
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      }, 3000);
    }

    // Orders Filter State
    let currentSelectedOrder = null;
    let orderSearchQuery = '';
    let orderFilterDate = 'all';
    let orderFilterPayment = 'all';
    let orderFilterFulfillment = 'all';

    // Format Indian Rupees helper
    function formatRupees(paise) {
      return `₹${((paise || 0) / 100).toFixed(2)}`;
    }

    // Format Date & Time helper
    function formatDateTime(epochSeconds) {
      if (!epochSeconds) return '—';
      const d = new Date(epochSeconds * 1000);
      return d.toLocaleDateString('en-IN', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hour12: true
      });
    }

    // Render Dashboard Recent Orders
    function renderDashboardOrders(orders) {
      const tbody = document.getElementById('dashboard-recent-orders-body');
      if (!tbody) return;
      if (orders.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="text-center py-8 text-xs text-slate-400">
              <div class="max-w-xs mx-auto space-y-2">
                <svg class="w-8 h-8 text-slate-300 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                <div class="font-bold text-slate-700 text-xs">No customer orders placed yet</div>
                <p class="text-[11px] text-slate-500">Orders will appear here when customers complete checkout / order creation.</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = orders.slice(0, 5).map(o => {
        const totalFmt = formatRupees(o.grand_total_paise);
        const payStatus = o.payment_status || 'pending';
        let payBadge = 'bg-amber-50 text-amber-700 border-amber-200';
        if (payStatus === 'paid') payBadge = 'bg-emerald-50 text-emerald-700 border-emerald-200';
        else if (payStatus === 'failed') payBadge = 'bg-rose-50 text-rose-700 border-rose-200';
        else if (payStatus === 'refunded') payBadge = 'bg-slate-100 text-slate-600 border-slate-200';

        const fulfillStatus = o.fulfillment_status || 'unfulfilled';
        let fulfillBadge = 'bg-slate-100 text-slate-600 border-slate-200';
        if (fulfillStatus === 'packed') fulfillBadge = 'bg-purple-50 text-purple-700 border-purple-200';
        else if (fulfillStatus === 'shipped') fulfillBadge = 'bg-indigo-50 text-indigo-700 border-indigo-200';
        else if (fulfillStatus === 'delivered') fulfillBadge = 'bg-emerald-50 text-emerald-700 border-emerald-200';

        return `
          <tr onclick="window.openOrderDetail('${o.id}')" class="hover:bg-slate-50/80 transition-colors cursor-pointer">
            <td class="font-mono font-bold text-indigo-700 text-xs">${o.order_number || o.id}</td>
            <td>
              <div class="font-semibold text-slate-800 text-xs">${o.customer_name || 'Customer'}</div>
              <div class="text-[10px] text-slate-400 font-mono">${o.customer_phone || ''}</div>
            </td>
            <td class="font-mono font-bold text-slate-900 text-xs">${totalFmt}</td>
            <td>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-bold border ${payBadge}">
                ${payStatus === 'paid' ? 'Prepaid (Paid)' : payStatus}
              </span>
            </td>
            <td>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-bold border ${fulfillBadge}">
                ${fulfillStatus}
              </span>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Render Orders Tab Table with Merchant-First Layout
    function renderOrdersTable(orders) {
      const tbody = document.getElementById('orders-table-body');
      const totalBadge = document.getElementById('orders-total-badge');
      const activeBar = document.getElementById('orders-filter-active-bar');
      const activeText = document.getElementById('orders-filter-count-text');
      if (!tbody) return;

      // Filter locally
      const now = new Date();
      let filtered = orders.filter(o => {
        // Search query
        if (orderSearchQuery) {
          const q = orderSearchQuery.toLowerCase();
          const matchId = (o.order_number && o.order_number.toLowerCase().includes(q)) || (o.id && o.id.toLowerCase().includes(q));
          const matchName = o.customer_name && o.customer_name.toLowerCase().includes(q);
          const matchPhone = o.customer_phone && o.customer_phone.toLowerCase().includes(q);
          if (!matchId && !matchName && !matchPhone) return false;
        }

        // Date range
        if (orderFilterDate === 'today') {
          const startToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime() / 1000;
          if (o.created_at < startToday) return false;
        } else if (orderFilterDate === '7days') {
          const start7 = (now.getTime() - 7 * 24 * 3600 * 1000) / 1000;
          if (o.created_at < start7) return false;
        } else if (orderFilterDate === '30days') {
          const start30 = (now.getTime() - 30 * 24 * 3600 * 1000) / 1000;
          if (o.created_at < start30) return false;
        } else if (orderFilterDate === 'month') {
          const startMonth = new Date(now.getFullYear(), now.getMonth(), 1).getTime() / 1000;
          if (o.created_at < startMonth) return false;
        }

        // Payment status
        if (orderFilterPayment !== 'all') {
          if (o.payment_status !== orderFilterPayment) return false;
        }

        // Fulfillment status
        if (orderFilterFulfillment !== 'all') {
          if (orderFilterFulfillment === 'new' && o.fulfillment_status !== 'unfulfilled' && o.fulfillment_status !== 'new') return false;
          else if (orderFilterFulfillment === 'rto' && o.fulfillment_status !== 'rto' && o.fulfillment_status !== 'returned') return false;
          else if (orderFilterFulfillment !== 'new' && orderFilterFulfillment !== 'rto' && o.fulfillment_status !== orderFilterFulfillment) return false;
        }

        return true;
      });

      if (totalBadge) {
        totalBadge.textContent = `${orders.length} order${orders.length === 1 ? '' : 's'}`;
      }

      const isFiltered = Boolean(orderSearchQuery || orderFilterDate !== 'all' || orderFilterPayment !== 'all' || orderFilterFulfillment !== 'all');
      if (activeBar) {
        if (isFiltered) {
          activeBar.classList.remove('hidden');
          if (activeText) activeText.textContent = `Showing ${filtered.length} of ${orders.length} orders`;
        } else {
          activeBar.classList.add('hidden');
        }
      }

      // Empty State
      if (filtered.length === 0) {
        if (orders.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="9" class="text-center py-12 text-xs text-slate-400">
                <div class="max-w-sm mx-auto space-y-3">
                  <div class="w-12 h-12 rounded-2xl bg-amber-50 text-[#F57C00] flex items-center justify-center mx-auto text-xl font-bold shadow-xs">
                    <svg class="w-6 h-6 text-[#F57C00]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                  </div>
                  <div class="font-extrabold text-slate-800 text-base">No customer orders yet</div>
                  <p class="text-xs text-slate-500 leading-relaxed font-medium">Orders will appear here when customers complete checkout / order creation.</p>
                  <div class="pt-2 flex justify-center gap-2">
                    <button onclick="window.refreshMerchantData()" class="px-3.5 py-1.5 text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 rounded-lg border border-slate-300 transition shadow-2xs cursor-pointer">
                      Sync Live Orders
                    </button>
                    <button onclick="window.switchTab('products')" class="px-3.5 py-1.5 text-xs font-bold text-white bg-[#D62828] hover:bg-[#b51e1e] rounded-lg transition shadow-xs cursor-pointer">
                      View Products Catalog
                    </button>
                  </div>
                </div>
              </td>
            </tr>
          `;
        } else {
          tbody.innerHTML = `
            <tr>
              <td colspan="9" class="text-center py-12 text-xs text-slate-400">
                <div class="max-w-xs mx-auto space-y-2">
                  <div class="font-bold text-slate-700 text-sm">No orders match your filter criteria</div>
                  <p class="text-[11px] text-slate-500">Try modifying your search query or reset date and status filters.</p>
                  <button onclick="window.resetOrdersFilters()" class="text-xs text-[#D62828] font-bold hover:underline cursor-pointer pt-1">
                    Clear all filters
                  </button>
                </div>
              </td>
            </tr>
          `;
        }
        return;
      }

      tbody.innerHTML = filtered.map(o => {
        const totalFmt = formatRupees(o.grand_total_paise);
        const dateStr = formatDateTime(o.created_at);
        const itemCount = o.item_count || 1;

        // Payment status badge
        const payStatus = o.payment_status || 'pending';
        let payBadge = 'bg-amber-50 text-amber-700 border-amber-200';
        let payLabel = 'Payment Pending';
        if (payStatus === 'paid') {
          payBadge = 'bg-emerald-50 text-emerald-700 border-emerald-200';
          payLabel = 'Prepaid (Paid)';
        } else if (payStatus === 'failed') {
          payBadge = 'bg-rose-50 text-rose-700 border-rose-200';
          payLabel = 'Payment Failed';
        } else if (payStatus === 'refunded') {
          payBadge = 'bg-slate-100 text-slate-600 border-slate-200';
          payLabel = 'Refunded';
        }

        // Fulfillment status badge
        const fulfillStatus = o.fulfillment_status || 'unfulfilled';
        let fulfillBadge = 'bg-slate-100 text-slate-600 border-slate-200';
        let fulfillLabel = fulfillStatus;
        if (fulfillStatus === 'unfulfilled' || fulfillStatus === 'new') {
          fulfillBadge = 'bg-blue-50 text-blue-700 border-blue-200';
          fulfillLabel = 'New / Unfulfilled';
        } else if (fulfillStatus === 'confirmed') {
          fulfillBadge = 'bg-indigo-50 text-indigo-700 border-indigo-200';
          fulfillLabel = 'Confirmed';
        } else if (fulfillStatus === 'processing') {
          fulfillBadge = 'bg-sky-50 text-sky-700 border-sky-200';
          fulfillLabel = 'Processing';
        } else if (fulfillStatus === 'packed') {
          fulfillBadge = 'bg-purple-50 text-purple-700 border-purple-200';
          fulfillLabel = 'Packed';
        } else if (fulfillStatus === 'shipped') {
          fulfillBadge = 'bg-violet-50 text-violet-700 border-violet-200';
          fulfillLabel = 'Shipped';
        } else if (fulfillStatus === 'delivered') {
          fulfillBadge = 'bg-emerald-50 text-emerald-700 border-emerald-200';
          fulfillLabel = 'Delivered';
        } else if (fulfillStatus === 'cancelled') {
          fulfillBadge = 'bg-rose-50 text-rose-700 border-rose-200';
          fulfillLabel = 'Cancelled';
        } else if (fulfillStatus === 'rto' || fulfillStatus === 'returned') {
          fulfillBadge = 'bg-amber-50 text-amber-800 border-amber-200';
          fulfillLabel = 'Returned / RTO';
        }

        // Shipping AWB status
        let shippingCell = `<span class="text-slate-400 text-xs">Awaiting Dispatch</span>`;
        if (o.shipment_awb) {
          shippingCell = `
            <div class="flex items-center gap-1.5">
              <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-purple-50 text-purple-700 border border-purple-200">
                ${o.shipment_awb}
              </span>
            </div>
          `;
        }

        // Contextual Primary Action Button
        let actionBtn = `
          <button onclick="window.openOrderDetail('${o.id}')" class="px-3 py-1 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-semibold transition cursor-pointer">
            View Order
          </button>
        `;
        if (o.order_status === 'pending') {
          actionBtn = `
            <button onclick="window.openOrderDetail('${o.id}')" class="px-3 py-1 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-xs font-bold transition shadow-xs cursor-pointer">
              Review & Confirm
            </button>
          `;
        } else if (fulfillStatus === 'unfulfilled' || fulfillStatus === 'new') {
          actionBtn = `
            <button onclick="window.openOrderDetail('${o.id}')" class="px-3 py-1 bg-[#D62828] hover:bg-[#b51e1e] text-white rounded-lg text-xs font-bold transition shadow-xs cursor-pointer">
              Fulfill
            </button>
          `;
        } else if (fulfillStatus === 'packed' && !o.shipment_awb) {
          actionBtn = `
            <button onclick="window.openOrderDetail('${o.id}')" class="px-3 py-1 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-xs font-bold transition shadow-xs cursor-pointer">
              Generate AWB
            </button>
          `;
        } else if (fulfillStatus === 'packed' && o.shipment_awb) {
          actionBtn = `
            <button onclick="window.openOrderDetail('${o.id}')" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition shadow-xs cursor-pointer">
              Ship Order
            </button>
          `;
        }

        return `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td>
              <button onclick="window.openOrderDetail('${o.id}')" class="font-mono font-bold text-indigo-700 text-xs hover:underline cursor-pointer">
                ${o.order_number || o.id}
              </button>
            </td>
            <td class="text-xs text-slate-500 font-mono">${dateStr}</td>
            <td>
              <div class="font-semibold text-slate-800 text-xs">${o.customer_name || 'Customer'}</div>
              <div class="text-[10px] text-slate-400 font-mono">${o.customer_phone || ''}</div>
            </td>
            <td class="text-xs text-slate-600 font-medium">${itemCount} item${itemCount === 1 ? '' : 's'}</td>
            <td class="font-mono font-bold text-slate-900 text-xs">${totalFmt}</td>
            <td>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold border ${payBadge}">
                ${payLabel}
              </span>
            </td>
            <td>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold border ${fulfillBadge}">
                ${fulfillLabel}
              </span>
            </td>
            <td>${shippingCell}</td>
            <td class="text-right whitespace-nowrap">${actionBtn}</td>
          </tr>
        `;
      }).join('');
    }

    // Reset Filters
    window.resetOrdersFilters = function() {
      orderSearchQuery = '';
      orderFilterDate = 'all';
      orderFilterPayment = 'all';
      orderFilterFulfillment = 'all';

      const s = document.getElementById('orders-search-input');
      const d = document.getElementById('orders-filter-date');
      const p = document.getElementById('orders-filter-payment');
      const f = document.getElementById('orders-filter-fulfillment');

      if (s) s.value = '';
      if (d) d.value = 'all';
      if (p) p.value = 'all';
      if (f) f.value = 'all';

      renderOrdersTable(adminOrders);
    };

    // Filter Listeners
    const ordSearchInput = document.getElementById('orders-search-input');
    const ordDateFilter = document.getElementById('orders-filter-date');
    const ordPayFilter = document.getElementById('orders-filter-payment');
    const ordFulfillFilter = document.getElementById('orders-filter-fulfillment');

    if (ordSearchInput) {
      ordSearchInput.addEventListener('input', (e) => {
        orderSearchQuery = e.target.value.trim();
        renderOrdersTable(adminOrders);
      });
    }
    if (ordDateFilter) {
      ordDateFilter.addEventListener('change', (e) => {
        orderFilterDate = e.target.value;
        renderOrdersTable(adminOrders);
      });
    }
    if (ordPayFilter) {
      ordPayFilter.addEventListener('change', (e) => {
        orderFilterPayment = e.target.value;
        renderOrdersTable(adminOrders);
      });
    }
    if (ordFulfillFilter) {
      ordFulfillFilter.addEventListener('change', (e) => {
        orderFilterFulfillment = e.target.value;
        renderOrdersTable(adminOrders);
      });
    }

    // ================= ORDER DETAIL MODAL LOGIC =================
    const orderModal = document.getElementById('order-detail-modal');
    const closeOrderModalBtn = document.getElementById('close-order-modal-btn');

    window.closeOrderDetailModal = function() {
      if (orderModal) orderModal.classList.add('hidden');
      currentSelectedOrder = null;
    };

    if (closeOrderModalBtn) {
      closeOrderModalBtn.addEventListener('click', window.closeOrderDetailModal);
    }

    // Open Order Detail Drawer/Modal
    window.openOrderDetail = async function(orderId) {
      if (!orderId) return;
      try {
        const res = await fetch(`/api/orders/${orderId}`);
        if (!res.ok) throw new Error('Order not found');
        const data = await res.json();
        const order = data.order;
        const items = data.items || [];
        currentSelectedOrder = order;

        // 1. Order Header
        const numEl = document.getElementById('od-order-number');
        const dateEl = document.getElementById('od-order-date');
        const payBadgeEl = document.getElementById('od-payment-badge');
        const fulfillBadgeEl = document.getElementById('od-fulfillment-badge');

        if (numEl) numEl.textContent = `Order #${order.order_number || order.id}`;
        if (dateEl) dateEl.textContent = `Created on ${formatDateTime(order.created_at)}`;

        const payStatus = order.payment_status || 'pending';
        if (payBadgeEl) {
          payBadgeEl.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold border ';
          if (payStatus === 'paid') {
            payBadgeEl.className += 'bg-emerald-50 text-emerald-700 border-emerald-200';
            payBadgeEl.textContent = 'Prepaid / Paid';
          } else if (payStatus === 'failed') {
            payBadgeEl.className += 'bg-rose-50 text-rose-700 border-rose-200';
            payBadgeEl.textContent = 'Payment Failed';
          } else if (payStatus === 'refunded') {
            payBadgeEl.className += 'bg-slate-100 text-slate-700 border-slate-200';
            payBadgeEl.textContent = 'Refunded';
          } else {
            payBadgeEl.className += 'bg-amber-50 text-amber-700 border-amber-200';
            payBadgeEl.textContent = 'Payment Pending';
          }
        }

        const fulfillStatus = order.fulfillment_status || 'unfulfilled';
        if (fulfillBadgeEl) {
          fulfillBadgeEl.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold border ';
          if (fulfillStatus === 'packed') {
            fulfillBadgeEl.className += 'bg-purple-50 text-purple-700 border-purple-200';
            fulfillBadgeEl.textContent = 'Packed';
          } else if (fulfillStatus === 'shipped') {
            fulfillBadgeEl.className += 'bg-violet-50 text-violet-700 border-violet-200';
            fulfillBadgeEl.textContent = 'Shipped';
          } else if (fulfillStatus === 'delivered') {
            fulfillBadgeEl.className += 'bg-emerald-50 text-emerald-700 border-emerald-200';
            fulfillBadgeEl.textContent = 'Delivered';
          } else if (fulfillStatus === 'cancelled') {
            fulfillBadgeEl.className += 'bg-rose-50 text-rose-700 border-rose-200';
            fulfillBadgeEl.textContent = 'Cancelled';
          } else {
            fulfillBadgeEl.className += 'bg-slate-100 text-slate-700 border-slate-200';
            fulfillBadgeEl.textContent = fulfillStatus;
          }
        }

        // 5. Visual Timeline Highlight
        const timelineSteps = ['new', 'paid', 'confirmed', 'processing', 'packed', 'shipped', 'delivered'];
        let activeIndex = 0;
        if (order.fulfillment_status === 'delivered') activeIndex = 6;
        else if (order.fulfillment_status === 'shipped') activeIndex = 5;
        else if (order.fulfillment_status === 'packed') activeIndex = 4;
        else if (order.order_status === 'processing') activeIndex = 3;
        else if (order.order_status === 'confirmed') activeIndex = 2;
        else if (order.payment_status === 'paid') activeIndex = 1;
        else activeIndex = 0;

        const timelineBar = document.getElementById('od-timeline-bar');
        if (timelineBar) {
          const pct = Math.min(100, Math.round((activeIndex / (timelineSteps.length - 1)) * 100));
          timelineBar.style.width = `${pct}%`;
        }

        document.querySelectorAll('.od-step').forEach((stepEl, idx) => {
          const circle = stepEl.querySelector('div');
          if (!circle) return;
          if (idx < activeIndex) {
            circle.className = 'w-7 h-7 rounded-full bg-emerald-600 text-white font-bold text-xs flex items-center justify-center transition';
            circle.textContent = '✓';
          } else if (idx === activeIndex) {
            circle.className = 'w-7 h-7 rounded-full bg-[#D62828] text-white font-bold text-xs flex items-center justify-center transition ring-4 ring-red-100';
            circle.textContent = idx + 1;
          } else {
            circle.className = 'w-7 h-7 rounded-full bg-white border-2 border-slate-300 text-slate-400 font-bold text-xs flex items-center justify-center transition';
            circle.textContent = idx + 1;
          }
        });

        // 3. Order Items Table & Breakdown
        const itemsCountEl = document.getElementById('od-items-count');
        const itemsTbody = document.getElementById('od-items-tbody');
        if (itemsCountEl) itemsCountEl.textContent = items.length;

        if (itemsTbody) {
          if (items.length === 0) {
            itemsTbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-slate-400">No items recorded for this order.</td></tr>`;
          } else {
            itemsTbody.innerHTML = items.map(item => `
              <tr class="border-b border-slate-100">
                <td>
                  <div class="font-bold text-slate-800">${item.product_name}</div>
                  <div class="text-[10px] text-slate-400 font-mono">${item.sku || 'SKU'} &bull; ${item.pack_size || 'Standard'}</div>
                </td>
                <td class="font-mono font-bold">${item.quantity}</td>
                <td class="font-mono">${formatRupees(item.unit_price_paise)}</td>
                <td class="font-mono font-bold text-right text-slate-900">${formatRupees(item.line_total_paise)}</td>
              </tr>
            `).join('');
          }
        }

        const subtotalEl = document.getElementById('od-subtotal');
        const discountRow = document.getElementById('od-discount-row');
        const discountEl = document.getElementById('od-discount');
        const discountLabel = document.getElementById('od-discount-label');
        const shippingEl = document.getElementById('od-shipping');
        const grandTotalEl = document.getElementById('od-grand-total');

        if (subtotalEl) subtotalEl.textContent = formatRupees(order.subtotal_paise);
        if (order.discount_paise && order.discount_paise > 0) {
          if (discountRow) discountRow.classList.remove('hidden');
          if (discountEl) discountEl.textContent = `-${formatRupees(order.discount_paise)}`;
          if (discountLabel) discountLabel.textContent = `Coupon (${order.coupon_code || 'Promo'}):`;
        } else {
          if (discountRow) discountRow.classList.add('hidden');
        }
        if (shippingEl) shippingEl.textContent = formatRupees(order.shipping_paise);
        if (grandTotalEl) grandTotalEl.textContent = formatRupees(order.grand_total_paise);

        // 6. Shipping / RapidShyp
        const courierNameEl = document.getElementById('od-courier-name');
        const awbNumberEl = document.getElementById('od-awb-number');
        const shipStatusPill = document.getElementById('od-shipping-status-pill');
        const genAwbBtn = document.getElementById('od-generate-awb-btn');
        const trackBtn = document.getElementById('od-track-shipment-btn');

        if (courierNameEl) courierNameEl.textContent = order.courier_name || 'RapidShyp Courier Allocation';
        if (awbNumberEl) awbNumberEl.textContent = order.shipment_awb || 'Not generated yet';

        if (shipStatusPill) {
          if (order.shipment_awb) {
            shipStatusPill.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200';
            shipStatusPill.textContent = 'AWB Allocated';
          } else {
            shipStatusPill.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200';
            shipStatusPill.textContent = 'Unassigned';
          }
        }

        if (genAwbBtn) {
          if (order.shipment_awb || order.fulfillment_status === 'shipped' || order.fulfillment_status === 'delivered') {
            genAwbBtn.disabled = true;
            genAwbBtn.classList.add('opacity-50', 'cursor-not-allowed');
          } else {
            genAwbBtn.disabled = false;
            genAwbBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          }
        }

        if (trackBtn) {
          if (!order.shipment_awb) {
            trackBtn.disabled = true;
            trackBtn.classList.add('opacity-50', 'cursor-not-allowed');
          } else {
            trackBtn.disabled = false;
            trackBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          }
        }

        // 2. Customer Card
        const custNameEl = document.getElementById('od-customer-name');
        const custPhoneEl = document.getElementById('od-customer-phone');
        const custEmailEl = document.getElementById('od-customer-email');
        const custAddrEl = document.getElementById('od-customer-address');
        const custNoteWrap = document.getElementById('od-customer-note-wrapper');
        const custNoteEl = document.getElementById('od-customer-note');

        if (custNameEl) custNameEl.textContent = order.customer_name || 'Customer';
        if (custPhoneEl) custPhoneEl.textContent = order.customer_phone || 'No phone recorded';
        if (custEmailEl) custEmailEl.textContent = order.customer_email || 'No email provided';

        const fullAddr = [
          order.delivery_address,
          order.apartment,
          order.city,
          order.state,
          order.pin_code,
          order.country || 'India'
        ].filter(Boolean).join(', ');

        if (custAddrEl) custAddrEl.textContent = fullAddr || 'No address provided';

        if (order.customer_note) {
          if (custNoteWrap) custNoteWrap.classList.remove('hidden');
          if (custNoteEl) custNoteEl.textContent = order.customer_note;
        } else {
          if (custNoteWrap) custNoteWrap.classList.add('hidden');
        }

        // 7. WhatsApp Link
        const waBtn = document.getElementById('od-whatsapp-btn');
        if (waBtn) {
          const rawPhone = (order.customer_phone || '').replace(/\D/g, '');
          const phone91 = rawPhone.length === 10 ? `91${rawPhone}` : rawPhone;
          const msg = `Hello ${order.customer_name || 'there'}, this is Fit Monk regarding your Order #${order.order_number || order.id}.`;
          waBtn.href = `https://wa.me/${phone91}?text=${encodeURIComponent(msg)}`;
        }

        // 4. Payment Details
        const payMethodEl = document.getElementById('od-payment-method');
        const payRefEl = document.getElementById('od-payment-ref');
        const payDateEl = document.getElementById('od-payment-date');

        if (payMethodEl) payMethodEl.textContent = order.payment_method_code || 'Direct UPI / QR (Prepaid)';
        if (payRefEl) payRefEl.textContent = order.payment_transaction_id || 'Direct Merchant Settlement';
        if (payDateEl) payDateEl.textContent = formatDateTime(order.created_at);

        // Internal Notes
        const noteInput = document.getElementById('od-admin-note-input');
        if (noteInput) noteInput.value = order.admin_note || '';

        // 8. Dynamic State Action Buttons
        renderOrderActions(order);

        // Show Modal
        if (orderModal) orderModal.classList.remove('hidden');
      } catch (err) {
        alert(err.message || 'Error opening order details');
      }
    };

    // Render Context-Specific Order Action Buttons
    function renderOrderActions(order) {
      const container = document.getElementById('od-state-actions');
      if (!container) return;

      const actions = [];
      const ordStatus = order.order_status || 'pending';
      const fulStatus = order.fulfillment_status || 'unfulfilled';
      const payStatus = order.payment_status || 'pending';

      // 1. Confirm Order
      if (ordStatus === 'pending') {
        actions.push(`
          <button onclick="window.updateOrderStatus('${order.id}', { order_status: 'confirmed', payment_status: 'paid' })" class="w-full py-2 px-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg transition shadow-xs cursor-pointer flex items-center justify-center gap-1.5">
            <span>✓ Confirm Prepaid Order</span>
          </button>
        `);
      }

      // 2. Mark Processing
      if (ordStatus === 'confirmed' || (ordStatus === 'pending' && fulStatus === 'unfulfilled')) {
        actions.push(`
          <button onclick="window.updateOrderStatus('${order.id}', { order_status: 'processing' })" class="w-full py-2 px-3 bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs rounded-lg transition shadow-xs cursor-pointer flex items-center justify-center gap-1.5">
            <span>Mark as Processing</span>
          </button>
        `);
      }

      // 3. Mark Packed
      if (fulStatus === 'unfulfilled' || fulStatus === 'new') {
        actions.push(`
          <button onclick="window.updateOrderStatus('${order.id}', { fulfillment_status: 'packed' })" class="w-full py-2 px-3 bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs rounded-lg transition shadow-xs cursor-pointer flex items-center justify-center gap-1.5">
            <span>Mark Packed in Warehouse</span>
          </button>
        `);
      }

      // 4. Mark Shipped
      if (fulStatus === 'packed') {
        actions.push(`
          <button onclick="window.updateOrderStatus('${order.id}', { fulfillment_status: 'shipped' })" class="w-full py-2 px-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-lg transition shadow-xs cursor-pointer flex items-center justify-center gap-1.5">
            <span>Mark Shipped / Handed to Courier</span>
          </button>
        `);
      }

      // 5. Mark Delivered
      if (fulStatus === 'shipped') {
        actions.push(`
          <button onclick="window.updateOrderStatus('${order.id}', { fulfillment_status: 'delivered' })" class="w-full py-2 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-lg transition shadow-xs cursor-pointer flex items-center justify-center gap-1.5">
            <span>Mark as Delivered</span>
          </button>
        `);
        actions.push(`
          <button onclick="window.updateOrderStatus('${order.id}', { fulfillment_status: 'rto' }, 'Are you sure you want to mark this shipment as Returned / RTO?')" class="w-full py-2 px-3 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs rounded-lg transition cursor-pointer flex items-center justify-center gap-1.5">
            <span>Mark Returned / RTO</span>
          </button>
        `);
      }

      // Destructive: Refund (if paid)
      if (payStatus === 'paid' && fulStatus !== 'delivered') {
        actions.push(`
          <button onclick="window.updateOrderStatus('${order.id}', { payment_status: 'refunded', order_status: 'cancelled' }, 'Are you sure you want to mark this prepaid order as Refunded?')" class="w-full py-2 px-3 bg-white hover:bg-rose-50 text-rose-700 border border-rose-300 font-semibold text-xs rounded-lg transition cursor-pointer flex items-center justify-center gap-1.5">
            <span>Refund Order</span>
          </button>
        `);
      }

      // Destructive: Cancel Order
      if (ordStatus !== 'cancelled' && fulStatus !== 'delivered') {
        actions.push(`
          <button onclick="window.updateOrderStatus('${order.id}', { order_status: 'cancelled', fulfillment_status: 'cancelled' }, 'Are you sure you want to cancel this order?')" class="w-full py-2 px-3 bg-white hover:bg-slate-100 text-slate-600 border border-slate-300 font-medium text-xs rounded-lg transition cursor-pointer flex items-center justify-center gap-1.5">
            <span>Cancel Order</span>
          </button>
        `);
      }

      container.innerHTML = actions.join('');
    }

    // Update Order Status Handler
    window.updateOrderStatus = async function(orderId, patchData, confirmMsg) {
      if (confirmMsg && !confirm(confirmMsg)) return;

      try {
        const res = await fetch(`/api/orders/${orderId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(patchData)
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showToast('Order status updated successfully');
          await loadAdminOrders();
          await window.openOrderDetail(orderId);
        } else {
          alert(data.message || 'Failed to update order status');
        }
      } catch (e) {
        alert('Server communication error');
      }
    };

    // RapidShyp Generate AWB Handler
    window.handleGenerateAwb = async function() {
      if (!currentSelectedOrder) return;
      if (!confirm('Generate RapidShyp courier shipment and assign AWB?')) return;

      try {
        const res = await fetch('/api/shipping/rapidshyp?action=create_shipment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId: currentSelectedOrder.id })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showToast(`AWB ${data.awb} generated via ${data.courier}`);
          await loadAdminOrders();
          await window.openOrderDetail(currentSelectedOrder.id);
        } else {
          alert(data.message || data.error || 'Failed to create shipment');
        }
      } catch (e) {
        alert('Shipping server error');
      }
    };

    // RapidShyp Track Shipment Handler
    window.handleTrackShipment = async function() {
      if (!currentSelectedOrder || !currentSelectedOrder.shipment_awb) return;
      const awb = currentSelectedOrder.shipment_awb;
      const trackingModal = document.getElementById('order-tracking-modal');
      const awbLabel = document.getElementById('tracking-modal-awb');
      const container = document.getElementById('tracking-events-container');

      if (awbLabel) awbLabel.textContent = `AWB: ${awb}`;
      if (container) container.innerHTML = `<div class="text-slate-400 text-center py-6">Connecting to RapidShyp tracking network...</div>`;
      if (trackingModal) trackingModal.classList.remove('hidden');

      try {
        const res = await fetch('/api/shipping/rapidshyp?action=track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ awb })
        });
        const data = await res.json();
        if (res.ok) {
          const events = data.events || [];
          if (events.length === 0) {
            container.innerHTML = `
              <div class="p-4 rounded-xl bg-purple-50 border border-purple-200 text-xs text-purple-900">
                <div class="font-bold">Shipment Created: ${awb}</div>
                <div class="text-[11px] text-purple-700 mt-1">Courier partner: ${currentSelectedOrder.courier_name || 'RapidShyp'}</div>
                <div class="text-[11px] text-purple-600 mt-1">Status: ${data.status || 'Ready for warehouse pickup'}</div>
              </div>
            `;
          } else {
            container.innerHTML = events.map(ev => `
              <div class="p-3 rounded-lg bg-slate-50 border border-slate-200">
                <div class="font-bold text-slate-800">${ev.status}</div>
                <div class="text-[11px] text-slate-500 mt-0.5">${ev.location || 'Hub'} &bull; ${ev.timestamp || ''}</div>
              </div>
            `).join('');
          }
        } else {
          container.innerHTML = `<div class="text-rose-600 text-center py-4">${data.error || 'Tracking lookup failed'}</div>`;
        }
      } catch (e) {
        container.innerHTML = `<div class="text-rose-600 text-center py-4">Error connecting to tracking service.</div>`;
      }
    };

    // Save Admin Note Handler
    window.saveOrderAdminNote = async function() {
      if (!currentSelectedOrder) return;
      const noteInput = document.getElementById('od-admin-note-input');
      const admin_note = noteInput ? noteInput.value.trim() : '';
      await window.updateOrderStatus(currentSelectedOrder.id, { admin_note });
    };

    // Copy Customer Phone
    window.copyCustomerPhone = function() {
      if (!currentSelectedOrder || !currentSelectedOrder.customer_phone) return;
      navigator.clipboard.writeText(currentSelectedOrder.customer_phone);
      showToast('Phone number copied to clipboard');
    };

    // Copy Customer Address
    window.copyCustomerAddress = function() {
      if (!currentSelectedOrder) return;
      const fullAddr = [
        currentSelectedOrder.delivery_address,
        currentSelectedOrder.apartment,
        currentSelectedOrder.city,
        currentSelectedOrder.state,
        currentSelectedOrder.pin_code,
        currentSelectedOrder.country || 'India'
      ].filter(Boolean).join(', ');
      navigator.clipboard.writeText(fullAddr);
      showToast('Delivery address copied to clipboard');
    };

    // Render Dashboard Top Products
    function renderDashboardTopProducts(products) {
      const container = document.getElementById('dashboard-top-products-list');
      if (!container) return;
      if (products.length === 0) {
        container.innerHTML = `<div class="text-xs text-slate-400 text-center py-4">No products loaded.</div>`;
        return;
      }

      container.innerHTML = products.slice(0, 5).map(p => {
        const priceFmt = p.price ? `₹${p.price}` : `₹${(p.price_paise / 100).toFixed(2)}`;
        return `
          <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200/80 transition">
            <div class="min-w-0 pr-2">
              <div class="font-bold text-xs text-[#2E2E2E] truncate">${p.name}</div>
              <div class="text-[10px] text-slate-500 flex items-center gap-1.5 mt-0.5">
                <span class="font-mono">${p.pack_size || 'Standard'}</span>
                <span>&bull;</span>
                <span class="font-mono font-bold text-slate-800">${priceFmt}</span>
              </div>
            </div>
            <button onclick="window.openEditProduct('${p.id}')" class="px-2 py-1 text-[11px] font-bold text-[#D62828] hover:bg-red-50 rounded transition cursor-pointer flex-shrink-0">
              Edit
            </button>
          </div>
        `;
      }).join('');
    }

    // Render Inventory Table
    function renderInventoryTable(products) {
      const tbody = document.getElementById('inventory-table-body');
      if (!tbody) return;
      if (products.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-xs text-slate-400">No inventory products loaded.</td></tr>`;
        return;
      }

      tbody.innerHTML = products.map((p, idx) => {
        const isAvail = Boolean(p.is_available);
        const priceFmt = p.price ? `₹${p.price}` : `₹${(p.price_paise / 100).toFixed(2)}`;
        const statusBadge = isAvail
          ? '<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">In Stock / Active</span>'
          : '<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">Disabled</span>';

        return `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td>
              <div class="font-bold text-[#2E2E2E] text-xs">${p.name}</div>
              <div class="text-[10px] text-slate-400 font-mono">Catalog #${p.catalog_number || idx + 1}</div>
            </td>
            <td class="font-mono text-xs text-slate-600 font-bold">${p.sku || '—'}</td>
            <td class="text-xs text-slate-700">${p.pack_size || '—'}</td>
            <td class="font-mono text-xs text-slate-600">${p.weight_grams ? `${p.weight_grams}g` : '—'}</td>
            <td class="font-mono font-bold text-slate-900 text-xs">${priceFmt}</td>
            <td>${statusBadge}</td>
            <td class="text-right">
              <button onclick="window.openEditProduct('${p.id}')" class="px-2.5 py-1 text-xs font-semibold text-[#D62828] hover:bg-red-50 rounded-md transition cursor-pointer">
                Edit SKU
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Render Products Table
    const productsTableBody = document.getElementById('products-table-body');
    const productsCountLabel = document.getElementById('products-count-label');
    const prodSearchInput = document.getElementById('prod-search-input');
    const productModal = document.getElementById('product-modal');
    const productForm = document.getElementById('product-form');
    const productModalTitle = document.getElementById('product-modal-title');
    const productFormError = document.getElementById('product-form-error');
    const productFormSuccess = document.getElementById('product-form-success');
    const openNewProductBtn = document.getElementById('open-new-product-modal-btn');
    const headerAddProductBtn = document.getElementById('header-add-product-btn');
    const closeProductModalBtn = document.getElementById('close-product-modal-btn');
    const cancelProductBtn = document.getElementById('cancel-product-btn');

    function renderProductsTable(products) {
      if (!productsTableBody) return;
      if (productsCountLabel) {
        productsCountLabel.textContent = `${products.length} catalog product${products.length === 1 ? '' : 's'} managed in Cloudflare D1`;
      }
      if (products.length === 0) {
        productsTableBody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-xs text-slate-500">No products found.</td></tr>`;
        return;
      }

      productsTableBody.innerHTML = products.map((p, idx) => {
        const isAvail = Boolean(p.is_available);
        const priceFmt = p.price ? `₹${p.price}` : `₹${(p.price_paise / 100).toFixed(2)}`;
        const statusClass = isAvail
          ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
          : 'bg-slate-100 text-slate-600 border-slate-200';

        return `
          <tr data-prod-id="${p.id}" class="hover:bg-slate-50/80 transition-colors">
            <td class="font-mono text-xs text-slate-400 font-semibold">${p.catalog_number || idx + 1}</td>
            <td>
              <div class="font-bold text-[#2E2E2E] text-xs leading-snug">${p.name}</div>
              <div class="text-[10px] text-slate-400 font-mono mt-0.5">slug: /product/${p.slug}/</div>
            </td>
            <td>
              <span class="text-xs text-slate-600 font-medium">${p.category_name || p.category_id || 'General'}</span>
            </td>
            <td>
              <div class="font-mono font-bold text-slate-900 text-xs">${priceFmt}</div>
              ${p.compare_at_price ? `<div class="font-mono text-[10px] text-slate-400 line-through">₹${p.compare_at_price}</div>` : ''}
            </td>
            <td>
              <div class="text-xs text-slate-700 font-medium">${p.pack_size || '—'}</div>
              <div class="text-[10px] text-slate-400 font-mono">${p.sku || '—'}</div>
            </td>
            <td>
              <button 
                onclick="window.toggleProductActive('${p.id}', ${isAvail})"
                title="Click to ${isAvail ? 'Disable' : 'Enable'}"
                class="px-2.5 py-0.5 rounded-full text-xs font-bold border transition cursor-pointer ${statusClass}">
                ${isAvail ? '● Active' : '○ Disabled'}
              </button>
            </td>
            <td class="text-right whitespace-nowrap">
              <button onclick="window.openEditProduct('${p.id}')" class="px-2.5 py-1 text-xs font-semibold text-[#D62828] hover:bg-red-50 rounded-md transition cursor-pointer">
                Edit
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Search filter
    if (prodSearchInput) {
      prodSearchInput.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        if (!q) {
          renderProductsTable(adminProducts);
          return;
        }
        const filtered = adminProducts.filter(p => 
          (p.name && p.name.toLowerCase().includes(q)) ||
          (p.slug && p.slug.toLowerCase().includes(q)) ||
          (p.sku && p.sku.toLowerCase().includes(q)) ||
          (p.category_name && p.category_name.toLowerCase().includes(q))
        );
        renderProductsTable(filtered);
      });
    }

    // Toggle Active / Disabled
    window.toggleProductActive = async function(id, currentAvail) {
      try {
        const nextAvail = !currentAvail;
        const res = await fetch(`/api/products/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_available: nextAvail ? 1 : 0 })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          const item = adminProducts.find(p => p.id === id);
          if (item) item.is_available = nextAvail;
          renderProductsTable(adminProducts);
          renderInventoryTable(adminProducts);
          updateCatalogBadge(adminProducts);
        } else {
          alert(data.message || 'Failed to update product status.');
        }
      } catch (e) {
        alert('Network error while updating status.');
      }
    };

    // Open Edit Modal
    window.openEditProduct = function(id) {
      const p = adminProducts.find(item => item.id === id);
      if (!p) return;

      productFormError.classList.add('hidden');
      productFormSuccess.classList.add('hidden');
      productModalTitle.textContent = 'Edit Product';

      document.getElementById('prod-id').value = p.id;
      document.getElementById('prod-name').value = p.name || '';
      document.getElementById('prod-slug').value = p.slug || '';
      document.getElementById('prod-category').value = p.category_id || 'seeds-nuts-snack-mixes';
      document.getElementById('prod-price').value = p.price || (p.price_paise ? (p.price_paise / 100).toFixed(2) : '');
      document.getElementById('prod-compare-price').value = p.compare_at_price || (p.compare_at_price_paise ? (p.compare_at_price_paise / 100).toFixed(2) : '');
      document.getElementById('prod-pack-size').value = p.pack_size || '';
      document.getElementById('prod-sku').value = p.sku || '';
      document.getElementById('prod-weight').value = p.weight_grams || '';
      document.getElementById('prod-desc').value = p.description || '';
      document.getElementById('prod-status').value = p.status || 'published';
      document.getElementById('prod-available').checked = Boolean(p.is_available);
      document.getElementById('prod-featured').checked = Boolean(p.is_featured);

      productModal.classList.remove('hidden');
    };

    // Open New Modal
    window.openNewProduct = function() {
      productFormError.classList.add('hidden');
      productFormSuccess.classList.add('hidden');
      productModalTitle.textContent = 'Add New Product';
      productForm.reset();
      document.getElementById('prod-id').value = '';
      document.getElementById('prod-available').checked = true;
      document.getElementById('prod-status').value = 'published';
      productModal.classList.remove('hidden');
    };

    if (openNewProductBtn) openNewProductBtn.addEventListener('click', window.openNewProduct);
    if (headerAddProductBtn) headerAddProductBtn.addEventListener('click', window.openNewProduct);

    // Slug auto-generation on name change (for new products)
    const prodNameInput = document.getElementById('prod-name');
    const prodSlugInput = document.getElementById('prod-slug');
    if (prodNameInput && prodSlugInput) {
      prodNameInput.addEventListener('input', () => {
        if (!document.getElementById('prod-id').value) {
          prodSlugInput.value = prodNameInput.value
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
        }
      });
    }

    function closeProductModal() {
      productModal.classList.add('hidden');
      productForm.reset();
      productFormError.classList.add('hidden');
      productFormSuccess.classList.add('hidden');
    }

    if (closeProductModalBtn) closeProductModalBtn.addEventListener('click', closeProductModal);
    if (cancelProductBtn) cancelProductBtn.addEventListener('click', closeProductModal);

    // Save Product Form Handler
    if (productForm) {
      productForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        productFormError.classList.add('hidden');
        productFormSuccess.classList.add('hidden');

        const editId = document.getElementById('prod-id').value;
        const payload = {
          name: document.getElementById('prod-name').value.trim(),
          slug: document.getElementById('prod-slug').value.trim(),
          category_id: document.getElementById('prod-category').value,
          price: Number(document.getElementById('prod-price').value),
          compare_at_price: document.getElementById('prod-compare-price').value ? Number(document.getElementById('prod-compare-price').value) : null,
          pack_size: document.getElementById('prod-pack-size').value.trim(),
          sku: document.getElementById('prod-sku').value.trim(),
          weight_grams: document.getElementById('prod-weight').value ? Number(document.getElementById('prod-weight').value) : null,
          description: document.getElementById('prod-desc').value.trim(),
          status: document.getElementById('prod-status').value,
          is_available: document.getElementById('prod-available').checked ? 1 : 0,
          is_featured: document.getElementById('prod-featured').checked ? 1 : 0
        };

        const url = editId ? `/api/products/${editId}` : '/api/products';
        const method = editId ? 'PUT' : 'POST';

        try {
          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (res.ok && data.success) {
            productFormSuccess.textContent = editId ? 'Product updated successfully.' : 'Product created successfully.';
            productFormSuccess.classList.remove('hidden');
            setTimeout(() => {
              closeProductModal();
              loadAdminProducts();
            }, 700);
          } else {
            productFormError.textContent = data.message || 'Failed to save product.';
            productFormError.classList.remove('hidden');
          }
        } catch (err) {
          productFormError.textContent = 'Server communication error.';
          productFormError.classList.remove('hidden');
        }
      });
    }

    // Coupon Live Tester
    const testCouponBtn = document.getElementById('test-coupon-btn');
    const testCouponResult = document.getElementById('test-coupon-result');
    if (testCouponBtn) {
      testCouponBtn.addEventListener('click', async () => {
        const code = document.getElementById('test-coupon-code').value;
        const total = Number(document.getElementById('test-coupon-total').value) || 0;
        testCouponResult.classList.remove('hidden');
        testCouponResult.textContent = 'Validating on edge server...';

        try {
          const res = await fetch('/api/coupons/validate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              code,
              subtotalPaise: total * 100
            })
          });
          const data = await res.json();
          testCouponResult.innerHTML = `
            <div class="${data.isValid ? 'text-emerald-700 font-bold' : 'text-[#D62828] font-bold'}">
              ${data.isValid ? '✓ Valid Coupon Applied!' : '✗ ' + (data.message || 'Invalid coupon')}
            </div>
            <div class="text-slate-700 mt-1 font-semibold">
              Discount: <span class="text-emerald-700 font-bold font-mono">${data.discountFormatted || '₹0.00'}</span> | 
              New Subtotal: <span class="text-[#2E2E2E] font-bold font-mono">${data.newSubtotalFormatted || '₹0.00'}</span>
            </div>
          `;
        } catch (e) {
          testCouponResult.textContent = 'Error connecting to validation endpoint.';
        }
      });
    }

    checkAuth();
  </script>
</body>
</html>
