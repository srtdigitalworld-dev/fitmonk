---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import Icon from '../components/ui/Icon.astro';
---
<BaseLayout title={`Contact | ${site.brandName}`} description="Contact Fit Monk on WhatsApp for product details and order confirmation."><div class="content-page"><div class="page-heading"><p class="eyebrow">We’re a message away</p><h1>Let’s talk pantry.</h1><p>Ask about a product, a pack size or your delivery. Confirm the details with us before placing your order.</p></div><section class="contact-panel"><Icon name="chat" size={32} /><h2>Connect on WhatsApp.</h2><p>Our catalog ordering number is +{site.whatsappOrderNumber}. Use it to confirm product labels, availability, shipping and your order.</p><a class="button" href={`https://wa.me/${site.whatsappOrderNumber}`} target="_blank" rel="noopener noreferrer">Message Fit Monk <Icon name="arrow" size={18} /></a></section><div class="story-layout"><div><h2>Already picked your favourites?</h2><p>Add them to your cart and enter your delivery details. We’ll prepare an itemised message for you to send on WhatsApp.</p><a class="text-link" href="/cart/">Review your shopping bag ↗</a></div><div><h2>Still exploring?</h2><p>Browse the shop by food category, compare pack options and read the available catalog details.</p><a class="text-link" href="/shop/">Find your next pantry pick ↗</a></div></div></div></BaseLayout>
